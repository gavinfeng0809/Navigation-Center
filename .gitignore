# ============================================================
#  机密与运行时数据 —— 绝对不能提交
#  这个项目里有企微 Secret、采集器写库令牌、管理员密码、客户设备地址。
# ============================================================

# 实际环境变量（模板 .env.example 可以提交）
.env
.env.local

# 企微采集器的真实配置（含 BotID + Secret）
wecom-bot/config.env
wecom-bot/config.env.bak-*
wecom-bot/state/
wecom-bot/*.log

# 明文初始密码清单、客户站点原始台账
docs/账号分发清单.txt
docs/Forti 版本升级*.xlsx

# 数据库（含 23 个账号的密码哈希、客户通知正文）
data/
backups/
*.db
*.db-wal
*.db-shm
*.sqlite

# 邮件原文页与企微图片（含客户拓扑、联系方式）
public/originals/
public/wecom-media/

# 邮件归档：只保留说明文档，不收真实邮件
inbox/*
!inbox/README.txt
!inbox/README-页面粘贴模板.txt

# ============================================================
#  依赖 / 缓存 / 构建产物
# ============================================================
.venv/
wecom-bot/venv/
venv/
__pycache__/
*.pyc
*.pyo
node_modules/

# ============================================================
#  杂项
# ============================================================
*.log
*.tmp
.DS_Store
Thumbs.db
_check.js

# 本地改动备份
*.bak-*
*.bak-??????

# 早期手工验证页面（iframe 调试用，非应用代码）
tools/verify_*.html
