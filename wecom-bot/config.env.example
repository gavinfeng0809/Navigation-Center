# ═══════════════════════════════════════════════════════════
# 企微「重要通知」自动归档采集器 —— 配置文件
# 复制成 config.env 后填真实值：cp config.env.example config.env
# 改完重启：systemctl restart wecom-bot
# ═══════════════════════════════════════════════════════════

# ─── 1. 智能机器人凭证（必填，找企微管理员要）───
# 路径：企业微信管理后台 → 智能机器人 → 找到/新建机器人
#      → 「API 模式」选「长连接」→ 拿到 BotID 与 Secret
# 注意：API 模式只能在「长连接」和「设置接收消息回调地址」里二选一；
#      选长连接后不需要公网 IP、不需要填回调 URL、不需要处理加解密。
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# 默认连 wss://openws.work.weixin.qq.com，一般不用改。
# 只在本地联调（指向 mock 服务端）时才填。
#WECOM_WS_URL=ws://127.0.0.1:8765

# ─── 2. 入库目标 ───
# notice-hub 只绑内网网卡，所以这里必须用内网 IP，不能用 127.0.0.1
NOTICE_BASE=http://10.0.0.10:8091
# 同步令牌：留空则自动读 /data/notice-hub/.env 里的 SYNC_TOKEN（推荐留空）
NOTICE_TOKEN=

# ─── 3. 归档范围 ───
# 允许的会话类型，逗号分隔。group=群聊 / single=单聊
ALLOW_CHATTYPES=group,single

# 允许的群白名单（chatid，逗号分隔）。留空 = 任何群里 @机器人都收。
# chatid 从日志里能看到（收到消息时会打印），第一次可以先留空跑一跑。
ALLOW_CHATIDS=

# 把「提问」挡在归档之外（默认 1=开）。
# 同事很容易把机器人当搜索用 —— 实测发过「帮我查询以下近期的重要通知内容」，
# 结果被当成「重要通知 / urgent」归档了。开着的话这类消息只回执说明、不入库。
# 识别规则很窄（只看开头 + 限 50 字以内），宁可漏判也不误杀真通知。
SKIP_QUERIES=1

# 每多少秒在日志里报一次「长连接正常（已运行 N 分钟，本次已归档 M 条）」。
# 唯一用途：把「采集器挂了」和「没人 @ 机器人」区分开 ——
# 企微只在被 @ 时才推消息，「日志安静」本身说明不了问题。默认 600。
HEALTH_LOG_INTERVAL=600

# 关键词要求。REQUIRE_KEYWORD=1 时，正文必须命中 KEYWORDS 里任意一个才归档。
# 默认 0 = 只要 @了机器人就归档（推荐，靠 @ 这个动作当开关）。
REQUIRE_KEYWORD=1
# 注意匹配是子串判断，「【重要通知】」含于「重要通知」，不必单列。
KEYWORDS=重要通知,紧急通知,割接通知

# 去掉正文开头的「@机器人名」（@机器人时正文必然带这个前缀）
STRIP_MENTION=1

# 机器人在群里的显示名。**名字里带空格时必须填**，例如「通知归档 助手」。
# 不填也能跑，但 @ 前缀只能按「@ + 非空白字符」去猜，
# 带空格的名字会剥不干净，正文开头留下半截名字，而标题默认取首行 ——
# 结果就是每条归档通知的标题都多出几个字。
BOT_NAME=通知归档助手

# ─── 4. 归到通知中心里的什么分类/级别 ───
DEFAULT_CATEGORY=重要通知
DEFAULT_LEVEL=urgent
# 「待汇总」= 交给 Hermes 做汇总分析的凭据（与邮件链路的标签保持一致）。
# Hermes 会把正文重构成「关键字：… / 【一句话】… / 结构化正文」，
# 并把标签换成真正的关键字。只想要原样归档、不做分析，就改成「企微自动归档」。
TAGS=待汇总

# 入库前自动跑「规则版整理重点」：抽关键字、摘要点、行动句加粗。
# 纯规则、不联网、不调模型 —— 和页面「一键整理重点」是同一套规则
# （wecom-bot/polish_rules.py 从 public/notices.html 逐行移植，
#   一致性由 node wecom-bot/test_polish_parity.js 盯着）。
# 关键字同时写进正文首部「关键字：…」和 tags 字段。
# 注意：真正的「【一句话】」语义摘要规则做不到，那一步仍归 Hermes。
AUTO_POLISH=1

# ─── 5. 群名映射（可选，让你在页面「来源」列看到中文群名而不是 chatid）───
# 格式：chatid=群名称，多个用逗号分隔。chatid 第一次收到消息时会打在日志里。
#CHAT_NAMES=wrOgQhDgAA=运维值班群,wrOgQhDgBB=网络变更群

# ─── 5b. 发布人显示名（可选，建议做）───
# 格式：userid=姓名，多个用逗号分隔。
# 为什么必须手工维护：企微的消息回调里 from **只有 userid**，没有显示名，
# 长连接 SDK 也没有查用户资料的接口，所以拿不到企微里的中文名/英文名。
# 没配到的会原样显示 userid，并在日志里打一行提示帮你补。
#USER_NAMES=ChenXuJie=Alex Chen,WangZheng=韩征

# ─── 6. 图片处理 ───
# 图文混排消息里的图片会下载到 public/wecom-media/，详情页直接显示
DOWNLOAD_MEDIA=1
MEDIA_DIR=/data/notice-hub/public/wecom-media
MEDIA_URL_PREFIX=/wecom-media

# ─── 7. 运维开关 ───
# 收到消息后在群里回一条「已归档」回执（建议开着，发的人心里有数）
REPLY_ACK=1
# 1 = 只打印不写库（调试用）
DRY_RUN=0
